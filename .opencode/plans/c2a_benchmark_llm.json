{
  "plan_version": 1,
  "date": "2026-08-01",
  "task": "C.2a Perf-7",
  "title": "LLM batch scheduler performance benchmark",
  "objective": "Measure real vLLM Phase-3 performance across batch_size={3,4,5,6} x max_concurrency={1,2}, then change production settings only if a faster option maintains summary quality and reliability.",
  "matrix": {
    "batch_sizes": [3, 4, 5, 6],
    "concurrencies": [1, 2],
    "warmups": 1,
    "runs": 3
  },
  "corpus_source": "Next real pipeline run Phase-3 inputs, captured via scripts/capture_corpus.py",
  "metrics": [
    "end_to_end_wall_time",
    "median_wall_time",
    "min_wall_time",
    "max_wall_time",
    "total_completions",
    "batch_completions",
    "fallback_completions",
    "valid_final_summaries",
    "invalid_empty_batch",
    "parse_failures",
    "boilerplate_count",
    "refusal_count",
    "auto_fallback_count",
    "unavailable_count",
    "stories_per_second",
    "max_observed_concurrency",
    "sub_batch_count"
  ],
  "selection_rule": {
    "min_improvement_percent": 10,
    "baseline": {"batch_size": 3, "max_concurrency": 1},
    "conditions": [
      "No increased invalid-summary rate",
      "No increased fallback or [Auto] rate",
      "No timeout or request failure regression",
      "No parser quality regression"
    ]
  },
  "files_to_create": [
    "scripts/capture_corpus.py",
    "scripts/benchmark_llm_batches.py",
    "tests/test_benchmark_llm_batches.py"
  ],
  "adoption_gate": [
    "benchmark script tests pass",
    "scripts/run_tests.sh passes",
    "python -m daily_brief config validate passes",
    "one full live pipeline run",
    "validate_report passes",
    "document in SUMMARY.md"
  ]
}
